{
    // One debug configuration per experiment. Each runs `python -m src.experiments`
    // from the project root so that relative paths (config.yaml, data/, results/) resolve.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Quick smoke test (all, --quick)",
            "type": "debugpy",
            "request": "launch",
            "module": "src.experiments",
            "args": ["--exp", "all", "--quick"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Experiment: ablation",
            "type": "debugpy",
            "request": "launch",
            "module": "src.experiments",
            "args": ["--exp", "ablation"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Experiment: compression",
